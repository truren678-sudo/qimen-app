{
  "name": "qimen-app",
  "version": "1.0.0",
  "description": "A professional Qimen Dunjia (奇門遁甲) chart calculation system built with React.",
  "author": "truren678",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/truren678-sudo/qimen-app.git"
  },
  "keywords": [
    "qimen",
    "qimen-dunjia",
    "chinese-astrology",
    "bazi",
    "lunar-calendar"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:android": "vite build --mode capacitor",
    "android:sync": "npm run build:android && cap sync android",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6"
  }
}
